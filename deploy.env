# 배포 설정. deploy-prep.sh / deploy.sh 가 읽는다.

# GitHub Pages 소유 계정 (github.com)
GH_OWNER=hanoseok

# 커스텀 도메인. 비워두면 https://<GH_OWNER>.github.io/<저장소>/ 로 배포된다.
# 넣으면 hub = https://<도메인>/, 나머지 사이트 = https://<사이트>.<도메인>/ 이 되고 CNAME 파일이 만들어진다.
# DNS 설정은 README.md "커스텀 도메인 연결" 참고.
CUSTOM_DOMAIN=melgene.com

# 소스 저장소: 이 폴더 전체 = github.com/<GH_OWNER>/<SOURCE_REPO> 의 main 브랜치.
# deploy.sh 는 이 저장소의 main 에는 절대 배포(강제 푸시)하지 않고 gh-pages 브랜치로만 올린다.
SOURCE_REPO=melgene-miniapp

# 미니앱은 https://<MINIAPP_SUB>.<CUSTOM_DOMAIN>/<사이트>/ 로 배포된다 (저장소 REPO_miniapp 하나에 모두).
# 배포 브랜치: REPO_<단위> 가 SOURCE_REPO 와 같으면 gh-pages, 다르면 main (BRANCH_<단위> 로 따로 정할 수도 있다).
# ── 전환 스위치 (한 줄) ──
#   REPO_miniapp=miniapp          → 예전: hanoseok/miniapp 의 main
#   REPO_miniapp=melgene-miniapp  → 새: hanoseok/melgene-miniapp 의 gh-pages (CNAME miniapp.melgene.com)
# 바꾸기 전에 GitHub Pages 커스텀 도메인 miniapp.melgene.com 을 hanoseok/miniapp 에서 떼어 내야 한다
# (도메인은 한 저장소에만 붙는다). README "배포" 참고.
MINIAPP_SUB=miniapp
# 2026-09-27: melgene-miniapp 을 공개로 바꾸고(사용자 결정) Pages 를 gh-pages 로 옮김.
REPO_miniapp=melgene-miniapp

# Google AdSense 게시자 ID (예: ca-pub-1234567890123456). 넣으면 모든 페이지 <head>에
# 자동 광고 스크립트와 ads.txt 가 들어간다. 광고 자리를 따로 잡지 않는다(Auto ads).
ADSENSE_CLIENT=ca-pub-6807370217216401

# 허브 저장소 + 예전 서브도메인 리다이렉트용 저장소 (폴더명의 '-'는 '_'로 바꿔 적는다)
# REPO_<사이트> 는 이제 <사이트>.<도메인> → 미니앱 경로로 넘겨주는 리다이렉트만 담는다.
REPO_hub=today-test
REPO_past_life=past-life
REPO_ladder=ladder
REPO_life=life-story
# Google Search Console HTML 파일 인증 (배포 단위별, 공백으로 여러 개)
GSC_FILES_miniapp=googlea6d2c28765f03a02.html
GSC_FILES_hub=googlea6d2c28765f03a02.html

# 배포 커밋 작성자 (사용자 지정 — 회사 메일을 쓰지 않는다)
GIT_AUTHOR_NAME_DEPLOY=hanoseok
GIT_AUTHOR_EMAIL_DEPLOY=hanoseok@gmail.com
